# ---- Fase 1 (obrigatórias) ----
# Connection string do Postgres (Neon)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Credenciais do admin (login único)
ADMIN_USER="admin"
# Gere com: npm run hash-password -- "suaSenhaForte"
# IMPORTANTE (apenas em arquivos .env locais): o hash bcrypt contém "$",
# que o Next expande como variável. Escape cada "$" com "\$" no .env.local.
# Ex: ADMIN_PASSWORD_HASH="\$2a\$10\$abc..."
# Na Vercel (Environment Variables) cole o hash SEM escapar — lá é literal.
ADMIN_PASSWORD_HASH=""

# Segredo para assinar o cookie de sessão (use uma string longa e aleatória)
SESSION_SECRET="troque-por-uma-string-aleatoria-bem-longa"

# URL base pública da aplicação (usada para montar os links dos pacientes)
APP_URL="http://localhost:3000"

# ---- Fase 2 (opcionais; sem elas o envio é manual via wa.me e sem e-mail) ----
# CRON_SECRET=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
